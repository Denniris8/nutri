#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
before=$(git -C "$root" rev-parse HEAD)
git -C "$root" pull --ff-only
after=$(git -C "$root" rev-parse HEAD)

mysql_changed=0
nutri_changed=0
changed_files=$(git -C "$root" diff --name-only "$before" "$after" -- nutri/ garmin-connect-mcp/)
while IFS= read -r file; do
  case "$file" in
    nutri/mysql/migrations/*|nutri/mysql/migrate.sh|nutri/mysql/migrate.js)
      nutri_changed=1
      ;;
    nutri/mysql/*)
      mysql_changed=1
      ;;
    nutri/docker-compose.yml)
      mysql_changed=1
      nutri_changed=1
      ;;
    nutri/*|garmin-connect-mcp/*)
      nutri_changed=1
      ;;
  esac
done <<EOF
$changed_files
EOF

mysql_image_version=9.7
if [ -r /proc/device-tree/model ]; then
  device_model=$(tr -d '\000' < /proc/device-tree/model 2>/dev/null || true)
  case "$device_model" in
    *"Raspberry Pi"*) mysql_image_version=8.4 ;;
  esac
fi
export MYSQL_IMAGE_VERSION="$mysql_image_version"

# MySQL never needs recreation for migrations; Nutri applies them on startup.
compose_nutri() {
  docker compose --project-directory "$root/nutri" -f "$root/nutri/docker-compose.yml" "$@"
}

if [ "$mysql_changed" -eq 1 ]; then
  compose_nutri pull mysql
  compose_nutri up -d mysql
fi

if [ "$nutri_changed" -eq 1 ]; then
  compose_nutri build --pull nutri
fi

nutri_container=$(compose_nutri ps --all -q nutri)
nutri_health=missing
if [ -n "$nutri_container" ]; then
  nutri_health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$nutri_container")
fi

if [ "$nutri_changed" -eq 1 ] || [ "$nutri_health" = unhealthy ]; then
  compose_nutri up -d --build --force-recreate nutri
else
  compose_nutri up -d nutri
fi
