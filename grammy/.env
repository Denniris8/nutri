BOT_TOKEN=PON_AQUI_TU_TOKEN
ALLOWED_CHAT_IDS=

# --- Puente OpenCode ---
# Carpeta del proyecto (ruta EN LA RASPBERRY, no en el contenedor)
OPENCODE_PROJECT_DIR=/home/pcp/Desktop/app
# Registro del servicio OpenCode (montado solo lectura por compose)
OPENCODE_SERVICE_FILE=/opencode-state/service.json
# Como responder permisos del modelo: ask (botones en Telegram) | once | always | reject
OPENCODE_PERMISSION_MODE=ask
# Tiempo maximo por turno del modelo (ms)
OPENCODE_TURN_TIMEOUT_MS=900000
